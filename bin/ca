#!/usr/bin/env php
<?php

declare(strict_types=1);

use ContaAzulCli\ContaAzulApplication;
use Symfony\Component\Dotenv\Dotenv;

$autoloadPaths = [
  __DIR__ . '/../vendor/autoload.php',
  __DIR__ . '/../../../autoload.php',
];

$autoloadFile = null;
foreach ($autoloadPaths as $path) {
  if (file_exists($path)) {
    $autoloadFile = $path;
    break;
  }
}

if ($autoloadFile === null) {
  fwrite(
      STDERR,
      json_encode(
          [
            'correlation_id' => null,
            'http_status'    => null,
            'kind'           => 'client_error',
            'message'        => 'Dependências não encontradas. Execute "composer install".',
            'protocol_id'    => null,
            'retryable'      => false,
          ],
      ) . PHP_EOL,
  );
  exit(1);
}

require $autoloadFile;

$envFile = __DIR__ . '/../.env';
if (file_exists($envFile)) {
  $dotenv = new Dotenv();
  $dotenv->usePutenv(true);
  $dotenv->load($envFile);
}

$application = new ContaAzulApplication();
exit($application->run());
