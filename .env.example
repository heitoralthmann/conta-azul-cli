# Credenciais obrigatórias do app Conta Azul
CA_CLIENT_ID=your-client-id-here
CA_CLIENT_SECRET=your-client-secret-here

# Variáveis opcionais (descomente e ajuste conforme necessário)

# Scope OAuth2
# Sandbox do portal de desenvolvedores: NÃO defina — qualquer valor retorna invalid_scope
# Produção: exige scope explícito, e o valor precisa de aspas por conter espaços
# CA_SCOPE="openid profile aws.cognito.signin.user.admin"

# URI de redirecionamento OAuth2
# Sem TLS (padrão, se Conta Azul aceitar localhost):
# CA_REDIRECT_URI=http://localhost:9876/callback
# Com TLS via mkcert (necessário: a Conta Azul exige HTTPS e domínio, e recusa localhost):
# CA_REDIRECT_URI=https://conta-azul-cli.ddev.site:9876/callback
#
# NÃO troque o domínio: apesar do nome, isto NÃO depende de DDEV — *.ddev.site é
# só um wildcard DNS público que aponta para 127.0.0.1. Tentamos um nome mais
# neutro (conta-azul-cli.localtest.me, mesma propriedade de DNS) e o portal da
# Conta Azul respondeu erro interno de servidor ao cadastrar. Com ddev.site aceita.

# Certificado TLS local para o servidor de callback
# Gere com: mkcert -cert-file .certs/cert.pem -key-file .certs/key.pem conta-azul-cli.ddev.site
# Resolve para 127.0.0.1 via DNS público, sem /etc/hosts e sem container
# CA_CALLBACK_CERT=/path/to/.certs/cert.pem
# CA_CALLBACK_KEY=/path/to/.certs/key.pem

# Endpoint de autorização (padrão: {CA_AUTH_BASE_URL}/oauth2/authorize)
# Apps de PRODUÇÃO autorizam em host/path próprios, informados no painel:
# CA_AUTHORIZE_URL=https://login.contaazul.com/#/oauth/authorize

# URL base da API Conta Azul (padrão: https://api-v2.contaazul.com)
# CA_API_BASE_URL=https://api-v2.contaazul.com

# URL base do servidor de autenticação (padrão: https://auth.contaazul.com)
# CA_AUTH_BASE_URL=https://auth.contaazul.com

# Caminho do arquivo de tokens (padrão: ~/.config/conta-azul-cli/tokens.json)
# CA_CLI_TOKEN_PATH=~/.config/conta-azul-cli/tokens.json

# Bootstrap token para ambientes headless/CI (usar apenas no primeiro arranque)
# Após o primeiro uso, remova esta variável e deixe o arquivo de tokens persistido assumir
# CA_BOOTSTRAP_REFRESH_TOKEN=your-refresh-token-here
