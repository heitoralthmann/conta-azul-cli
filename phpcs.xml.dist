<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="conta-azul-cli">
  <description>Coding standard for the Conta Azul CLI, adapted from Interactive Strategies' is_drupal_boilerplate ruleset with the Drupal-specific sniffs removed.</description>

  <arg name="extensions" value="php"/>
  <!-- Project indentation uses spaces, with a tab expanded to two columns. -->
  <arg name="tab-width" value="2"/>

  <file>./src</file>
  <file>./tests</file>
  <file>./bin</file>
  <file>./phpcs-sniffs</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>

  <rule ref="Generic.CodeAnalysis.ForLoopShouldBeWhileLoop"/>

  <rule ref="Generic.CodeAnalysis.JumbledIncrementer"/>

  <rule ref="Generic.CodeAnalysis.UnconditionalIfStatement"/>

  <rule ref="Generic.Formatting.SpaceAfterCast.NoSpace">
    <type>warning</type>
  </rule>

  <rule ref="Generic.Functions.FunctionCallArgumentSpacing.SpaceBeforeComma">
    <type>warning</type>
  </rule>

  <rule ref="Generic.Functions.FunctionCallArgumentSpacing.TooMuchSpaceAfterComma">
    <type>warning</type>
  </rule>

  <rule ref="Generic.Functions.OpeningFunctionBraceKernighanRitchie">
    <type>warning</type>
  </rule>

  <rule ref="Generic.Metrics.NestingLevel">
    <properties>
      <property name="absoluteNestingLevel" value="99" />
      <property name="nestingLevel" value="8" />
    </properties>
  </rule>

  <rule ref="Generic.NamingConventions.UpperCaseConstantName.ClassConstantNotUpperCase">
    <type>warning</type>
  </rule>

  <rule ref="Generic.PHP.CharacterBeforePHPOpeningTag"/>

  <rule ref="Generic.PHP.DiscourageGoto">
    <type>error</type>
  </rule>

  <!-- Forbid functions that are insecure or that bypass Symfony's response buffering. -->
  <rule ref="Generic.PHP.ForbiddenFunctions">
    <properties>
      <property name="forbiddenFunctions" type="array">
        <element key="eval" value="null"/>
        <element key="extract" value="list"/>
        <element key="ob_end_flush" value="ob_get_clean"/>
        <element key="ob_flush" value="null"/>
        <element key="ob_get_flush" value="ob_get_clean"/>
      </property>
    </properties>
  </rule>

  <rule ref="Generic.PHP.NoSilencedErrors"/>

  <rule ref="Generic.PHP.UpperCaseConstant">
    <type>warning</type>
  </rule>

  <!-- Indentation is spaces only: tabs anywhere in leading whitespace are an error. -->
  <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>

  <!--
    exact="true" is what actually enforces the two-space rule. With the default
    exact="false" the sniff only reports lines indented *less* than expected, so
    over-indented lines pass silently and the report looks clean while the files
    are not.
  -->
  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <properties>
      <property name="indent" value="2" />
      <property name="tabIndent" value="false" />
      <property name="exact" value="true" />
    </properties>
  </rule>

  <!-- Closing braces line up with the statement that opened the scope. -->
  <rule ref="PEAR.WhiteSpace.ScopeClosingBrace">
    <properties>
      <property name="indent" value="2" />
    </properties>
  </rule>

  <!--
    ScopeIndent only governs indentation of scopes (classes, functions, control
    structures); it says nothing about elements inside a multi-line array, which
    is why array literals stayed at four spaces. This covers that gap.
  -->
  <rule ref="Generic.Arrays.ArrayIndent">
    <properties>
      <property name="indent" value="2" />
    </properties>
  </rule>

  <!-- Local reimplementation of ISDrupal.Functions.DebuggingFunctions. -->
  <rule ref="./phpcs-sniffs/ContaAzulCli/Sniffs/Functions/DebuggingFunctionsSniff.php">
    <type>error</type>
  </rule>

  <rule ref="PEAR.Functions.FunctionCallSignature">
    <properties>
      <property name="indent" value="2" />
    </properties>
  </rule>

  <rule ref="PEAR.Functions.FunctionCallSignature.Indent">
    <severity>5</severity>
    <type>warning</type>
  </rule>

  <rule ref="PEAR.Functions.FunctionCallSignature.SpaceAfterOpenBracket">
    <severity>5</severity>
    <type>warning</type>
  </rule>

  <rule ref="PEAR.Functions.FunctionCallSignature.SpaceBeforeCloseBracket">
    <severity>5</severity>
    <type>warning</type>
  </rule>

  <rule ref="PSR2.Namespaces.NamespaceDeclaration.BlankLineAfter">
    <type>warning</type>
  </rule>

  <rule ref="PSR2.Namespaces.UseDeclaration.SpaceAfterLastUse">
    <type>warning</type>
  </rule>

  <rule ref="PSR12.ControlStructures.BooleanOperatorPlacement">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Arrays.ArrayBracketSpacing">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Arrays.ArrayDeclaration.CloseBraceNewLine">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Arrays.ArrayDeclaration.CommaAfterLast">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Arrays.ArrayDeclaration.IndexNoNewline">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Arrays.ArrayDeclaration.NoSpaceAfterComma">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Arrays.ArrayDeclaration.SpaceInEmptyArray">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.ControlStructures.ForLoopDeclaration">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.ControlStructures.SwitchDeclaration.MissingCase">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.ControlStructures.SwitchDeclaration.SpacingAfterBreak">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.ControlStructures.SwitchDeclaration.SpaceBeforeColonCase">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Functions.FunctionDeclarationArgumentSpacing">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Operators.ValidLogicalOperators">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.PHP.DisallowSizeFunctionsInLoops">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.PHP.InnerFunctions">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Scope.StaticThisUsage"/>

  <rule ref="Squiz.Strings.ConcatenationSpacing">
    <properties>
      <property name="spacing" value="1" />
    </properties>
    <type>warning</type>
  </rule>

  <rule ref="Squiz.Strings.DoubleQuoteUsage.NotRequired">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.WhiteSpace.FunctionSpacing">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.WhiteSpace.OperatorSpacing">
    <type>warning</type>
  </rule>

  <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
    <type>warning</type>
  </rule>
</ruleset>
