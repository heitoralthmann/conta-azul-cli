{
    "name": "heitoralthmann/conta-azul-cli",
    "description": "CLI PHP/Symfony para as APIs Financeiro, Pessoas, Produtos e Serviços da Conta Azul",
    "type": "project",
    "keywords": ["conta-azul", "cli", "api-client", "oauth2", "symfony-console", "php"],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Heitor Althmann",
            "email": "heitoralthmann@gmail.com"
        }
    ],
    "homepage": "https://github.com/heitoralthmann/conta-azul-cli",
    "support": {
        "issues": "https://github.com/heitoralthmann/conta-azul-cli/issues",
        "source": "https://github.com/heitoralthmann/conta-azul-cli"
    },
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ramsey/uuid": "^4.0",
        "symfony/console": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "doctrine/coding-standard": "^13.0",
        "infection/infection": "^0.34.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "suggest": {
        "ext-posix": "Enables full CLI behavior on Unix-like systems; guarded and unused on Windows."
    },
    "autoload": {
        "psr-4": {
            "ContaAzulCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContaAzulCli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ca"
    ],
    "scripts": {
        "test": "phpunit --no-coverage",
        "lint": [
            "@lint:src",
            "@lint:bin"
        ],
        "lint:src": "phpcs",
        "lint:bin": "phpcs --stdin-path=$PWD/bin/ca.php - < bin/ca",
        "format": [
            "@format:src",
            "@format:bin"
        ],
        "format:src": "phpcbf; c=$?; [ $c -le 1 ]",
        "format:bin": "t=$(mktemp); phpcbf --stdin-path=$PWD/bin/ca.php - < bin/ca > \"$t\"; if [ -s \"$t\" ]; then mv \"$t\" bin/ca; chmod +x bin/ca; else rm -f \"$t\"; fi",
        "stan": [
            "@stan:src",
            "@stan:tests"
        ],
        "stan:src": "phpstan analyse src/ --memory-limit=1G",
        "stan:tests": "phpstan analyse tests/ --level=6 --memory-limit=1G",
        "mutation": "infection --threads=max"
    },
    "scripts-descriptions": {
        "test": "Runs the PHPUnit test suite.",
        "lint": "Checks coding standards. bin/ca is piped through STDIN under a .php path because PHP_CodeSniffer refuses to lint extensionless files.",
        "format": "Applies the coding standard in place, bin/ca included.",
        "stan": "Runs PHPStan on src/ (level max, per phpstan.neon) and tests/ (level 6).",
        "mutation": "Runs Infection mutation testing."
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable"
}
