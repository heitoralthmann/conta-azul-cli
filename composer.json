{
    "name": "contaazul-cli/cli",
    "description": "CLI PHP/Symfony para as APIs Financeiro, Pessoas, Produtos e Serviços da Conta Azul",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.0",
        "symfony/http-client": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/dotenv": "^7.0",
        "symfony/filesystem": "^7.0",
        "symfony/yaml": "^7.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "ContaAzulCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContaAzulCli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ca"
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
